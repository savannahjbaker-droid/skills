# Copy to .env and fill in to make the Availity connector live.
# Without these, Availity reports "not configured" (other connectors still run).
# Obtain credentials from the Availity developer portal: https://developer.availity.com/

AVAILITY_CLIENT_ID=
AVAILITY_CLIENT_SECRET=
# Override only if Availity gives you a non-default base URL.
AVAILITY_BASE_URL=https://api.availity.com/availity
